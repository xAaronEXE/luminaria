{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "luminaria-private-sync",
  "main": "src/private_sync.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "SYNC_ENABLED": "true" },
  "d1_databases": [
    { "binding": "DB", "database_name": "luminaria-private-sync", "database_id": "REPLACE_WITH_YOUR_D1_ID" }
  ],
  "r2_buckets": [
    { "binding": "SYNC_BUCKET", "bucket_name": "luminaria-private-sync" }
  ]
}
